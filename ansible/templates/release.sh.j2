#!/bin/bash
# {{ ansible_managed }}
# Upload compendium content from the local drive to blob storage for module development

# Prompt user with default to N (don't proceed)
read -p "Is the local 'artifacts' folder up to date? (y/N): " -n 1 -r
echo    # Move to a new line

# Check if response is explicitly 'y' or 'Y', otherwise exit
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Exiting: Please ensure 'artifacts' folder is present and up to date before running this script."
    exit 1
fi

echo "Proceeding with sync..."
pm2 stop foundry
/usr/bin/rclone sync {{ foundry_data_dir }}/Data/modules/silentcatfarts-shared-assets "{{ rclone_remote }}":silentcatfarts-shared-assets
/usr/bin/rclone sync {{ foundry_artifacts_dir }} "{{ rclone_remote }}":artifacts
pm2 start foundry
